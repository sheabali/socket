# Deployment Environment Variables Template
# Copy this to .env on your production server (Railway/Render)

NODE_ENV=production
PORT=8000

# Database (MongoDB Atlas)
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>"

# Auth
JWT_SECRET="generate-a-long-secure-random-string"
EXPIRES_IN=2h
REFRESH_TOKEN_SECRET="generate-another-long-secure-random-string"
REFRESH_TOKEN_EXPIRES_IN=30d
RESET_PASS_TOKEN="generate-one-more-secure-string"
RESET_PASS_TOKEN_EXPIRES_IN=2h

# Security
PASSWORD_SALT=12

# AI Services
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY="your-production-groq-api-key"

# Payment (Stripe)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
FRONTEND_URL="https://your-frontend-domain.vercel.app"

# Email (Nodemailer)
EMAIL_SENDER_EMAIL="your-email@example.com"
EMAIL_SENDER_APP_PASS="your-app-specific-password"

# Supabase (Storage)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
